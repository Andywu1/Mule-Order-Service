<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">

    <http:listener-config name="HTTP_Listener_config">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <flow name="api-main">
        <http:listener config-ref="HTTP_Listener_config" path="/*"/>
        <flow-ref name="auth-validate"/>
        
        <choice>
            <!-- 订单 -->
            <when expression="#[attributes.method == 'POST' and attributes.requestPath == '/orders']">
                <flow-ref name="order-create"/>
            </when>
            <when expression="#[attributes.method == 'GET' and startsWith(attributes.requestPath, '/orders/')]">
                <flow-ref name="order-get"/>
            </when>
            <when expression="#[attributes.method == 'PUT' and startsWith(attributes.requestPath, '/orders/')]">
                <flow-ref name="order-update"/>
            </when>
            <when expression="#[attributes.method == 'DELETE' and startsWith(attributes.requestPath, '/orders/')]">
                <flow-ref name="order-delete"/>
            </when>

            <!-- 商品 -->
            <when expression="#[attributes.method == 'GET' and startsWith(attributes.requestPath, '/products/')]">
                <flow-ref name="product-get"/>
            </when>
            <when expression="#[attributes.method == 'POST' and attributes.requestPath == '/products']">
                <flow-ref name="product-create"/>
            </when>

            <!-- 支付 -->
            <when expression="#[attributes.method == 'POST' and attributes.requestPath == '/payments']">
                <flow-ref name="payment-process"/>
            </when>

            <otherwise>
                <set-payload value='{"code":"404","message":"API not found"}'/>
            </otherwise>
        </choice>
    </flow>
	
	
	</mule>
