{
	"info": {
		"_postman_id": "mule-homework",
		"name": "mule-homework",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081"
		},
		{
			"key": "token",
			"value": "TEST_TOKEN_123"
		},
		{
			"key": "orderId",
			"value": "ORD-1001"
		},
		{
			"key": "sku",
			"value": "SKU-001"
		}
	],
	"item": [
		{
			"name": "1. 创建订单 POST /orders",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customer\": {\n    \"id\": \"C-123\",\n    \"name\": \"张三\",\n    \"email\": \"zhangsan@example.com\"\n  },\n  \"items\": [\n    { \"sku\": \"SKU-001\", \"qty\": 2, \"discount\": 0.9 },\n    { \"sku\": \"SKU-002\", \"qty\": 1, \"discount\": 1.0 },\n    { \"sku\": \"SKU-003\", \"qty\": 1, \"discount\": 0.0 }\n  ],\n  \"payment\": {\n    \"method\": \"CREDIT_CARD\",\n    \"cardNumber\": \"4111111111111111\",\n    \"expiry\": \"12/2026\"\n  }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/orders",
					"host": ["{{baseUrl}}"],
					"path": ["orders"]
				}
			}
		},
		{
			"name": "2. 查询订单 GET /orders/{orderId}",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/orders/{{orderId}}",
					"host": ["{{baseUrl}}"],
					"path": ["orders", "{{orderId}}"]
				}
			}
		},
		{
			"name": "3. 更新订单 PUT /orders/{orderId}",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"items\": [\n    { \"sku\": \"SKU-001\", \"qty\": 3 }\n  ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/orders/{{orderId}}",
					"host": ["{{baseUrl}}"],
					"path": ["orders", "{{orderId}}"]
				}
			}
		},
		{
			"name": "4. 删除订单 DELETE /orders/{orderId}",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/orders/{{orderId}}",
					"host": ["{{baseUrl}}"],
					"path": ["orders", "{{orderId}}"]
				}
			}
		},
		{
			"name": "5. 查询商品 GET /products/{sku}",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/products/{{sku}}",
					"host": ["{{baseUrl}}"],
					"path": ["products", "{{sku}}"]
				}
			}
		},
		{
			"name": "6. 创建商品 POST /products",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"示例商品A\",\n  \"price\": 49.9\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": ["{{baseUrl}}"],
					"path": ["products"]
				}
			}
		},
		{
			"name": "7. 支付接口 POST /payments",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 99.9,\n  \"method\": \"CREDIT_CARD\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/payments",
					"host": ["{{baseUrl}}"],
					"path": ["payments"]
				}
			}
		}
	]
}